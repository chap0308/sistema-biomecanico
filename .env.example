APP_NAME="Biomechanics Backend"
APP_VERSION="0.1.0"
API_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true
TEMP_DIR="tmp"
REQUEST_TIMEOUT_SECONDS=120
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="videos"
SUPABASE_CHAT_BUCKET="chat-media"
SUPABASE_POSTURE_BUCKET="Postura"
SUPABASE_POSTURE_ANALYSIS_BUCKET="Postura-analisis"
SUPABASE_DB_URL=""
QDRANT_PREFER_EMBEDDED=false
QDRANT_PATH="data/qdrant_local"
QDRANT_URL="https://<your-cluster>.cloud.qdrant.io:6333"
QDRANT_API_KEY=""
QDRANT_CLOUD_API_KEY=""
QDRANT_COLLECTION="video_segments_v1"
QDRANT_KNOWLEDGE_COLLECTION="video_knowledge_units_v1"
HF_TOKEN=""
HF_ROUTER_URL="https://router.huggingface.co/v1/chat/completions"
HF_ANALYSIS_MODEL="openai/gpt-oss-120b"
HF_ANSWER_MODEL="Qwen/Qwen3-32B"
HF_ANSWER_MODEL_BALANCED="Qwen/Qwen3-32B"
HF_ANSWER_MODEL_CHEAP="Qwen/Qwen3-4B-Instruct-2507"
HF_PROVIDER="auto"
HF_TIMEOUT_SEC=120
HF_MAX_SEGMENTS=24
ANSWER_BACKEND="grounded"
OLLAMA_BASE_URL="http://localhost:11434"
CORS_ALLOWED_ORIGINS="http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://your-app.vercel.app"
OLLAMA_ANSWER_MODEL="qwen3:4b"
OLLAMA_TIMEOUT_SEC=180
OPENAI_API_KEY=""
