{
  "$defs": {
    "SquatArtifactManifest": {
      "additionalProperties": false,
      "description": "Portable relative paths exposed to an API or interface.",
      "properties": {
        "overlay_video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlay Video"
        },
        "review_video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Video"
        },
        "landmarks_csv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Landmarks Csv"
        },
        "frame_quality_csv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Quality Csv"
        },
        "pose_quality_plot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pose Quality Plot"
        },
        "frame_phases_csv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Phases Csv"
        },
        "repetitions_csv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repetitions Csv"
        },
        "segmentation_plot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segmentation Plot"
        },
        "biomechanical_frame_metrics_csv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biomechanical Frame Metrics Csv"
        },
        "biomechanical_repetition_metrics_csv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biomechanical Repetition Metrics Csv"
        },
        "biomechanical_metrics_plot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Biomechanical Metrics Plot"
        },
        "rule_evidence_csv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Evidence Csv"
        },
        "event_captures": {
          "items": {
            "$ref": "#/$defs/SquatEventCapture"
          },
          "title": "Event Captures",
          "type": "array"
        }
      },
      "title": "SquatArtifactManifest",
      "type": "object"
    },
    "SquatBiomechanicsArtifacts": {
      "description": "Files generated by the biomechanical-variable calculation stage.",
      "properties": {
        "frame_metrics_csv": {
          "title": "Frame Metrics Csv",
          "type": "string"
        },
        "repetition_metrics_csv": {
          "title": "Repetition Metrics Csv",
          "type": "string"
        },
        "metrics_plot": {
          "title": "Metrics Plot",
          "type": "string"
        },
        "summary_json": {
          "title": "Summary Json",
          "type": "string"
        }
      },
      "required": [
        "frame_metrics_csv",
        "repetition_metrics_csv",
        "metrics_plot",
        "summary_json"
      ],
      "title": "SquatBiomechanicsArtifacts",
      "type": "object"
    },
    "SquatBiomechanicsSummary": {
      "description": "Aggregate result of interpretable biomechanical calculations.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "stage": {
          "const": "variables_biomecanicas",
          "default": "variables_biomecanicas",
          "title": "Stage",
          "type": "string"
        },
        "landmarks_csv": {
          "title": "Landmarks Csv",
          "type": "string"
        },
        "frame_phases_csv": {
          "title": "Frame Phases Csv",
          "type": "string"
        },
        "normalization_reference": {
          "const": "initial_shoulder_width",
          "default": "initial_shoulder_width",
          "title": "Normalization Reference",
          "type": "string"
        },
        "initial_shoulder_width": {
          "exclusiveMinimum": 0.0,
          "title": "Initial Shoulder Width",
          "type": "number"
        },
        "valid_metric_frames": {
          "minimum": 0,
          "title": "Valid Metric Frames",
          "type": "integer"
        },
        "total_frames": {
          "minimum": 0,
          "title": "Total Frames",
          "type": "integer"
        },
        "repetitions": {
          "items": {
            "$ref": "#/$defs/SquatRepetitionMetrics"
          },
          "title": "Repetitions",
          "type": "array"
        },
        "conventions": {
          "items": {
            "type": "string"
          },
          "title": "Conventions",
          "type": "array"
        },
        "artifacts": {
          "$ref": "#/$defs/SquatBiomechanicsArtifacts"
        }
      },
      "required": [
        "case_id",
        "landmarks_csv",
        "frame_phases_csv",
        "initial_shoulder_width",
        "valid_metric_frames",
        "total_frames",
        "repetitions",
        "conventions",
        "artifacts"
      ],
      "title": "SquatBiomechanicsSummary",
      "type": "object"
    },
    "SquatEventCapture": {
      "additionalProperties": false,
      "description": "One anonymized visual checkpoint for a detected repetition.",
      "properties": {
        "repetition_index": {
          "minimum": 1,
          "title": "Repetition Index",
          "type": "integer"
        },
        "event": {
          "enum": [
            "inicio_descenso",
            "maxima_profundidad",
            "final_ascenso"
          ],
          "title": "Event",
          "type": "string"
        },
        "frame_index": {
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "timestamp_seconds": {
          "minimum": 0.0,
          "title": "Timestamp Seconds",
          "type": "number"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        }
      },
      "required": [
        "repetition_index",
        "event",
        "frame_index",
        "timestamp_seconds",
        "relative_path"
      ],
      "title": "SquatEventCapture",
      "type": "object"
    },
    "SquatFindingsArtifacts": {
      "description": "Files generated by the interpretable-rule stage.",
      "properties": {
        "rule_evidence_csv": {
          "title": "Rule Evidence Csv",
          "type": "string"
        },
        "findings_json": {
          "title": "Findings Json",
          "type": "string"
        }
      },
      "required": [
        "rule_evidence_csv",
        "findings_json"
      ],
      "title": "SquatFindingsArtifacts",
      "type": "object"
    },
    "SquatFindingsSummary": {
      "description": "Multilabel output from the provisional interpretable rule engine.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "stage": {
          "const": "criterios_biomecanicos_interpretables",
          "default": "criterios_biomecanicos_interpretables",
          "title": "Stage",
          "type": "string"
        },
        "ruleset_version": {
          "title": "Ruleset Version",
          "type": "string"
        },
        "ruleset_status": {
          "enum": [
            "provisional",
            "frozen"
          ],
          "title": "Ruleset Status",
          "type": "string"
        },
        "quality_gate_status": {
          "enum": [
            "apto_para_analisis",
            "revision_requerida",
            "no_apto_para_analisis"
          ],
          "title": "Quality Gate Status",
          "type": "string"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/SquatRuleDecision"
          },
          "title": "Decisions",
          "type": "array"
        },
        "detected_findings": {
          "items": {
            "type": "string"
          },
          "title": "Detected Findings",
          "type": "array"
        },
        "inconclusive_findings": {
          "items": {
            "type": "string"
          },
          "title": "Inconclusive Findings",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "artifacts": {
          "$ref": "#/$defs/SquatFindingsArtifacts"
        }
      },
      "required": [
        "case_id",
        "ruleset_version",
        "ruleset_status",
        "quality_gate_status",
        "decisions",
        "detected_findings",
        "inconclusive_findings",
        "notes",
        "artifacts"
      ],
      "title": "SquatFindingsSummary",
      "type": "object"
    },
    "SquatPoseArtifacts": {
      "description": "Files generated by the temporal pose-extraction stage.",
      "properties": {
        "landmarks_csv": {
          "title": "Landmarks Csv",
          "type": "string"
        },
        "frame_quality_csv": {
          "title": "Frame Quality Csv",
          "type": "string"
        },
        "overlay_video": {
          "title": "Overlay Video",
          "type": "string"
        },
        "review_video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Video"
        },
        "quality_plot": {
          "title": "Quality Plot",
          "type": "string"
        },
        "summary_json": {
          "title": "Summary Json",
          "type": "string"
        }
      },
      "required": [
        "landmarks_csv",
        "frame_quality_csv",
        "overlay_video",
        "quality_plot",
        "summary_json"
      ],
      "title": "SquatPoseArtifacts",
      "type": "object"
    },
    "SquatPoseSummary": {
      "description": "Aggregate quality indicators for pose extraction from one video.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "stage": {
          "const": "extraccion_pose_2d",
          "default": "extraccion_pose_2d",
          "title": "Stage",
          "type": "string"
        },
        "detector": {
          "const": "mediapipe_pose",
          "default": "mediapipe_pose",
          "title": "Detector",
          "type": "string"
        },
        "video_path": {
          "title": "Video Path",
          "type": "string"
        },
        "min_visibility_threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Visibility Threshold",
          "type": "number"
        },
        "total_frames": {
          "minimum": 0,
          "title": "Total Frames",
          "type": "integer"
        },
        "processed_frames": {
          "minimum": 0,
          "title": "Processed Frames",
          "type": "integer"
        },
        "frames_with_pose": {
          "minimum": 0,
          "title": "Frames With Pose",
          "type": "integer"
        },
        "valid_frames": {
          "minimum": 0,
          "title": "Valid Frames",
          "type": "integer"
        },
        "processed_frames_percentage": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Processed Frames Percentage",
          "type": "number"
        },
        "valid_frames_percentage": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Valid Frames Percentage",
          "type": "number"
        },
        "mean_detected_keypoints": {
          "maximum": 13.0,
          "minimum": 0.0,
          "title": "Mean Detected Keypoints",
          "type": "number"
        },
        "artifacts": {
          "$ref": "#/$defs/SquatPoseArtifacts"
        }
      },
      "required": [
        "case_id",
        "video_path",
        "min_visibility_threshold",
        "total_frames",
        "processed_frames",
        "frames_with_pose",
        "valid_frames",
        "processed_frames_percentage",
        "valid_frames_percentage",
        "mean_detected_keypoints",
        "artifacts"
      ],
      "title": "SquatPoseSummary",
      "type": "object"
    },
    "SquatQualityCheck": {
      "description": "One explicit technical acceptance criterion.",
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "severity": {
          "enum": [
            "exclusion",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "observed": {
          "title": "Observed",
          "type": "string"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "description",
        "severity",
        "passed",
        "observed",
        "requirement"
      ],
      "title": "SquatQualityCheck",
      "type": "object"
    },
    "SquatQualityGateArtifacts": {
      "description": "Files generated by the analytical quality gate.",
      "properties": {
        "summary_json": {
          "title": "Summary Json",
          "type": "string"
        }
      },
      "required": [
        "summary_json"
      ],
      "title": "SquatQualityGateArtifacts",
      "type": "object"
    },
    "SquatQualityGateSummary": {
      "description": "Decision on whether a processed video is usable for formal analysis.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "stage": {
          "const": "control_calidad_analitica",
          "default": "control_calidad_analitica",
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "apto_para_analisis",
            "revision_requerida",
            "no_apto_para_analisis"
          ],
          "title": "Status",
          "type": "string"
        },
        "eligible_for_analysis": {
          "title": "Eligible For Analysis",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/SquatQualityCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "exclusion_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Exclusion Reasons",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "artifacts": {
          "$ref": "#/$defs/SquatQualityGateArtifacts"
        }
      },
      "required": [
        "case_id",
        "status",
        "eligible_for_analysis",
        "checks",
        "exclusion_reasons",
        "warnings",
        "artifacts"
      ],
      "title": "SquatQualityGateSummary",
      "type": "object"
    },
    "SquatRepetition": {
      "description": "Temporal landmarks for one detected bilateral-squat repetition.",
      "properties": {
        "repetition_index": {
          "minimum": 1,
          "title": "Repetition Index",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "peak_depth_frame": {
          "minimum": 0,
          "title": "Peak Depth Frame",
          "type": "integer"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "start_seconds": {
          "minimum": 0.0,
          "title": "Start Seconds",
          "type": "number"
        },
        "peak_depth_seconds": {
          "minimum": 0.0,
          "title": "Peak Depth Seconds",
          "type": "number"
        },
        "end_seconds": {
          "minimum": 0.0,
          "title": "End Seconds",
          "type": "number"
        },
        "descent_duration_seconds": {
          "minimum": 0.0,
          "title": "Descent Duration Seconds",
          "type": "number"
        },
        "ascent_duration_seconds": {
          "minimum": 0.0,
          "title": "Ascent Duration Seconds",
          "type": "number"
        },
        "total_duration_seconds": {
          "minimum": 0.0,
          "title": "Total Duration Seconds",
          "type": "number"
        },
        "peak_hip_midpoint_y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Peak Hip Midpoint Y",
          "type": "number"
        },
        "valid_frames_percentage": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Valid Frames Percentage",
          "type": "number"
        }
      },
      "required": [
        "repetition_index",
        "start_frame",
        "peak_depth_frame",
        "end_frame",
        "start_seconds",
        "peak_depth_seconds",
        "end_seconds",
        "descent_duration_seconds",
        "ascent_duration_seconds",
        "total_duration_seconds",
        "peak_hip_midpoint_y",
        "valid_frames_percentage"
      ],
      "title": "SquatRepetition",
      "type": "object"
    },
    "SquatRepetitionMetrics": {
      "description": "Biomechanical measurements summarized for one repetition.",
      "properties": {
        "repetition_index": {
          "minimum": 1,
          "title": "Repetition Index",
          "type": "integer"
        },
        "peak_depth_frame": {
          "minimum": 0,
          "title": "Peak Depth Frame",
          "type": "integer"
        },
        "valid_frames_percentage": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Valid Frames Percentage",
          "type": "number"
        },
        "trunk_inclination_at_peak_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trunk Inclination At Peak Deg"
        },
        "trunk_max_abs_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trunk Max Abs Deg"
        },
        "trunk_max_abs_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trunk Max Abs Frame"
        },
        "pelvis_shift_at_peak_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pelvis Shift At Peak Pct"
        },
        "pelvis_max_abs_shift_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pelvis Max Abs Shift Pct"
        },
        "pelvis_max_abs_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pelvis Max Abs Frame"
        },
        "left_knee_medial_deviation_at_peak_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left Knee Medial Deviation At Peak Pct"
        },
        "right_knee_medial_deviation_at_peak_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Knee Medial Deviation At Peak Pct"
        },
        "left_knee_max_medial_deviation_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left Knee Max Medial Deviation Pct"
        },
        "right_knee_max_medial_deviation_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Knee Max Medial Deviation Pct"
        },
        "bilateral_alignment_difference_at_peak_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bilateral Alignment Difference At Peak Pct"
        },
        "bilateral_max_alignment_difference_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bilateral Max Alignment Difference Pct"
        }
      },
      "required": [
        "repetition_index",
        "peak_depth_frame",
        "valid_frames_percentage"
      ],
      "title": "SquatRepetitionMetrics",
      "type": "object"
    },
    "SquatRuleDecision": {
      "description": "Traceable classification produced by one biomechanical rule.",
      "properties": {
        "finding": {
          "title": "Finding",
          "type": "string"
        },
        "status": {
          "enum": [
            "presente",
            "ausente",
            "no_concluyente"
          ],
          "title": "Status",
          "type": "string"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "aggregate_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregate Value"
        },
        "repetition_values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Repetition Values",
          "type": "array"
        },
